# MongoDB Atlas Connection
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.qndvdch.mongodb.net/codebloom?retryWrites=true&w=majority
AUTH_SECRET=your-random-32-byte-base64-secret

# Optional GitHub REST API token for higher rate limits.
# Public repository metadata can be fetched without this at lower unauthenticated limits.
# Server only; never expose to browser bundles or logs.
GITHUB_TOKEN=

# Optional non-secret base URL for Playwright targeting a running application.
PLAYWRIGHT_BASE_URL=http://127.0.0.1:3000

# Production HTTPS origin only (scheme + host, no path/query); leave blank until deployed.
# Enables canonical URLs, absolute social-preview URLs, and the production sitemap.
NEXT_PUBLIC_SITE_URL=
